@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<https://github.com/Inneumo/ST-OSA-PS-OMT-Theraphy-Data>
    a dcat:Dataset ;
    dct:title "Orofacial Myofunctional Therapy Dataset for Obstructive Sleep Apnea" ;
    dct:description """This dataset supports the study
"Artificial Intelligence-Enhanced Telemedicine for Orofacial Myofunctional Therapy in Sleep Apnea: Adult Patient Outcomes".
It contains anonymised clinical and treatment-response data from 87 adult patients who underwent AI-assisted Orofacial Myofunctional Therapy (OMT) using the Smart Therapy Manager® system, aimed at treating Obstructive Sleep Apnea (OSA) and Primary Snoring (PS). The data are provided in CSV, XLSX, TTL, XML and JSON formats and are intended for clinical research, machine-learning, sleep-medicine and treatment-outcome analysis.""" ;
    dct:creator [
        a foaf:Person ;
        foaf:name "Diego Rincon-Yanez" ;
        foaf:mbox "mailto:rinconyanezd+ryfor@gmail.com" ;
        foaf:affiliation "WU Wien & Universidad de Pamplona" ;
        foaf:identifier <https://orcid.org/0000-0002-8982-1678>
    ] ;

        foaf:name "Eliana Elizabeth Rivera Capacho" ;
        foaf:mbox "mailto:<email>" ;          # placeholder
        foaf:affiliation "Universidad de Pamplona" ;
        foaf:identifier <https://orcid.org/0000-0001-7678-7522>
    ] ;
    dct:creator [
        a foaf:Person ;
        foaf:name "Heriberto Rangel-Navia" ;
        foaf:mbox "mailto:<email>" ;          # placeholder
        foaf:affiliation "Universidad de Pamplona" ;
        foaf:identifier <https://orcid.org/0000-0001-8903-6736>
    ] ;
    dct:creator [
        a foaf:Person ;
        foaf:name "Esther Mandelbaum Gonçalves Bianchini" ;
        foaf:mbox "mailto:<email>" ;          # placeholder
        foaf:affiliation "University of the Argentine Social Museum" ;
        foaf:identifier <https://orcid.org/0000-0002-2878-4826>
    ] ;
    dct:issued "2025-08-07"^^xsd:date ;
    dct:language "en" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:keyword "Sleep Apnea", "Respiratory Therapy", "Orofacial Therapy",
                 "Primary Snoring", "Myofunctional Characteristics" ;
